{
  "name": "worthyscroll",
  "version": "0.1.0",
  "description": "A worthy-scroll prototype for replacing short-video feeds with saved and intentional reading.",
  "license": "MIT",
  "private": false,
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "deploy": "npm run build && wrangler deploy",
    "db:apply": "wrangler d1 execute worthyscroll-db --remote --file cloudflare/d1/schema.sql"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260525.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.7.2",
    "wrangler": "^4.94.0"
  }
}
