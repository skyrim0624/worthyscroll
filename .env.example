SUPABASE_URL=https://<project-ref>.supabase.co

# 只能放在本机导入脚本或服务端，绝不能放进前端或 iOS 客户端。
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# 目标用户的 auth.users.id。第一版可先手动在 Supabase Auth 里创建用户后填入。
WORTHYSCROLL_USER_ID=<auth-user-uuid>

# 可选：Obsidian / 笔记同步助手导出的 Markdown 目录。
# 也可以运行脚本时传入：python3 scripts/import-wechat-notes.py --source-root /path/to/notes
WORTHYSCROLL_SOURCE_ROOT=./data/source-notes
